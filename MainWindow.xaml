<Window x:Class="BrowserSelect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BrowserSelect"
        mc:Ignorable="d"
        Title="Browser Selector" Height="500" Width="700" WindowStartupLocation="CenterScreen" Keyboard.KeyUp="Window_KeyUp">
    <Grid>
        <Grid Margin="10" Name="Grid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" Name="UrlRow"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="5">
                <CheckBox x:Name="IncognitoCheckBox" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Private window" FontSize="10" Margin="8,0,0,0"/>
                <TextBlock Text="Url" TextWrapping="Wrap" Foreground="Blue" FontSize="10" VerticalAlignment="Center" Name="Url"></TextBlock>
            </DockPanel>

            <!-- Top row: Firefox, left half of the window -->
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontSize="12" Margin="5" Name="FirefoxHeader">Firefox Profiles:</TextBlock>
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Hidden" Name="FirefoxListBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" SelectionChanged="FirefoxListBox_SelectionChanged" MouseDoubleClick="FirefoxListBox_MouseDoubleClick"
                     Keyboard.KeyUp="Listbox_KeyUp">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="FirefoxListBox_ContextMenu_Open_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding ToolTip}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Top row: Chromium, right half of the window -->
            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" FontSize="12" Margin="5" Name="ChromiumHeader">Chromium Profiles:</TextBlock>
            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Hidden" Name="ChromiumListBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="5" SelectionChanged="ChromiumListBox_SelectionChanged" MouseDoubleClick="ChromiumListBox_MouseDoubleClick"
                     Keyboard.KeyUp="Listbox_KeyUp">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="ChromiumListBox_ContextMenu_Open_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding ToolTip}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Second row: the remaining browsers, five across -->
            <Grid Grid.Row="3" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Margin="5" Name="EdgeHeader">Edge Profiles:</TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Margin="5" Name="HeliumHeader">Helium Profiles:</TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="2" FontSize="12" Margin="5" Name="ChromeHeader">Google Chrome Profiles:</TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="3" FontSize="12" Margin="5" Name="BraveHeader">Brave Profiles:</TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="4" FontSize="12" Margin="5" Name="WaterfoxHeader">Waterfox Profiles:</TextBlock>

                <ListBox ScrollViewer.HorizontalScrollBarVisibility="Hidden" Name="EdgeListBox" Grid.Row="1" Grid.Column="0" Margin="5" SelectionChanged="EdgeListBox_SelectionChanged" MouseDoubleClick="EdgeListBox_MouseDoubleClick"
                         Keyboard.KeyUp="Listbox_KeyUp">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="EdgeListBox_ContextMenu_Open_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding ToolTip}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox ScrollViewer.HorizontalScrollBarVisibility="Hidden" Name="HeliumListBox" Grid.Row="1" Grid.Column="1" Margin="5" SelectionChanged="HeliumListBox_SelectionChanged" MouseDoubleClick="HeliumListBox_MouseDoubleClick"
                         Keyboard.KeyUp="Listbox_KeyUp">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="HeliumListBox_ContextMenu_Open_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding ToolTip}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox ScrollViewer.HorizontalScrollBarVisibility="Hidden" Name="ChromeListBox" Grid.Row="1" Grid.Column="2" Margin="5" SelectionChanged="ChromeListBox_SelectionChanged" MouseDoubleClick="ChromeListBox_MouseDoubleClick"
                         Keyboard.KeyUp="Listbox_KeyUp">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="ChromeListBox_ContextMenu_Open_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding ToolTip}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox ScrollViewer.HorizontalScrollBarVisibility="Hidden" Name="BraveListBox" Grid.Row="1" Grid.Column="3" Margin="5" SelectionChanged="BraveListBox_SelectionChanged" MouseDoubleClick="BraveListBox_MouseDoubleClick"
                         Keyboard.KeyUp="Listbox_KeyUp">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="BraveListBox_ContextMenu_Open_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding ToolTip}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox ScrollViewer.HorizontalScrollBarVisibility="Hidden" Name="WaterfoxListBox" Grid.Row="1" Grid.Column="4" Margin="5" SelectionChanged="WaterfoxListBox_SelectionChanged" MouseDoubleClick="WaterfoxListBox_MouseDoubleClick"
                         Keyboard.KeyUp="Listbox_KeyUp">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="WaterfoxListBox_ContextMenu_Open_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding ToolTip}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" >
                <Button x:Name="SelectButton" Content="Select" Margin="5" Click="SelectButton_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" VerticalAlignment="Center" Margin="5" Name="StatusText" FontSize="10" Foreground="Gray"/>
        </Grid>
    </Grid>
</Window>